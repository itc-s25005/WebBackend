{
  "name": "${PROJECT_NAME}",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "private": {
    "name": "mini_board",
    "module": "../app.ts",
    "type": "module",
    "private": true,
    "scripts": {
      "dev:app": "bun ../app.ts",
      "dev:css": "bunx tailwindcss -m -i ../app.css -o style.css",
      "dev": "bun run --sequential dev:css dev:app",
      "watch:app": "bunx nodemon -w . -e ts,pug,css -x 'bun ../app.ts'",
      "watch:css": "bunx tailwindcss --watch=always -m -i ../app.css -o style.css",
      "watch": "bun run --parallel 'watch:*'"
    },
    "devDependencies": {
      "@tailwindcss/cli": "^4.3.3",
      "@types/bun": "latest",
      "@types/pug": "^2.0.10",
      "nodemon": "^3.1.14",
      "tailwindcss": "^4.3.3"
    },
    "peerDependencies": {
      "typescript": "^7"
    },
    "dependencies": {
      "pug": "^3.0.4"
    }
  },true
}
