extends ../layout

block content
  if errors
    ul.error
      each error in errors
        li= error.msg

  form(method='post' action='/users/edit')
    input(type='hidden' name='id' value=form.id)

    .form-group
      label(for='name') NAME
      input#name(type='text' name='name' value=form.name)

    .form-group
      label(for='password') PASSWORD
      input#password(type='password' name='password' value=form.password)

    .form-group
      label(for='email') E-MAIL
      input#email(type='text' name='email' value=form.email)

    .form-group
      label(for='age') AGE
      input#age(type='number' name='age' value=form.age)

    button(type='submit') 送信