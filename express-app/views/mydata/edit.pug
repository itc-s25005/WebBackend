extends ../layout

block content
  p= content
  if errors
    ul.error
      each error in errors
        li= error.msg
  form(method='post' action='/mydata/edit')
    input(type='hidden' name='id' value=mydata.id)
    .form-group
      label(for='name') NAME
      input#name(type='text' name='name' value=mydata.name)
    .form-group
      label(for='email') E-MAIL
      input#email(type='text' name='email' value=mydata.email)
    .form-group
      label(for='age') AGE
      input#age(type='number' name='age' value=mydata.age)
    button(type='submit') 更新