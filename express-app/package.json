{
  "name": "express-app",
  "module": "app.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "watch:app": "bunx nodemon -w . -e ts,pug -x 'bun app.ts'",
    "watch:css": "bunx tailwindcss --watch=always -m -i ./styles/app.css -o ./public/css/style.css",
    "watch": "bun run --parallel 'watch:*'"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/language-server": "^0.16.0",
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/pg": "^8.23.1",
    "@types/pug": "^2.0.10",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@types/express-session": "^1.19.0",
    "axios": "^1.20.0",
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "fast-xml-parser": "^5.11.2",
    "http-errors": "^2.0.1",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "pug": "^3.0.4"
  }
}