{
  "name": "express-app",
  "module": "app.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "bun check",
    "watch:app": "bunx nodemon -w . -e ts,pug -x 'bun app.ts'",
    "watch": "bun run --parallel 'watch:*'"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cookie-parser": "^1.4.10",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/pug": "^2.0.10",
    "nodemon": "^3.1.14"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "debug": "^4.4.3",
    "express": "^5.3.0",
    "http-errors": "^2.0.1",
    "morgan": "^1.12.1",
    "pug": "^3.0.4"
  }
}